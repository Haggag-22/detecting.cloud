# Logstash image for the evidence ingest workers.
#
# Same base and plugin set as the existing ./logstash/Dockerfile, plus the
# SQS-driven S3 input. The bundled logstash-integration-aws provides separate
# `s3` and `sqs` inputs but nothing that reads S3 objects *in response to* queue
# messages, which is the whole point of this pipeline.

FROM docker.elastic.co/logstash/logstash:8.15.0

RUN bin/logstash-plugin install \
    logstash-input-relp \
    logstash-input-google_pubsub \
    logstash-filter-tld \
    logstash-filter-json_encode \
    logstash-filter-cidr \
    logstash-input-s3-sns-sqs
